  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ============================================================",
          "// real-bank-api — Collection-level Pre-request Script",
          "// Runs before EVERY request in this collection",
          "// ============================================================",
          "",
          "// ----------------------------------------------------------",
          "// 1. GUARD: ensure accountNumber is set in the environment",
          "//    (populated by acc creation test script; fall back to a",
          "//     known default so individual requests still work)",
          "// ----------------------------------------------------------",
          "if (!pm.environment.get('accountNumber')) {",
          "    pm.environment.set('accountNumber', '856974578431');",
          "    console.warn('[pre-request] accountNumber not found in environment — using fallback value 856974578431');",
          "} else {",
          "    console.log('[pre-request] accountNumber =', pm.environment.get('accountNumber'));",
          "}",
          "",
          "// ----------------------------------------------------------",
          "// 2. GUARD: ensure acc creation body variables are present",
          "//    Fall back to sensible defaults if not set in environment",
          "// ----------------------------------------------------------",
          "var defaults = {",
          "    FullName:      'Anjali Boddeda',",
          "    dateOfBirth:   '2000-08-06',",
          "    mobileNumber:  '9074561230',",
          "    email:         'narsingbeesetti22@gmail.com',",
          "    address:       'Chowduvada, 123/5',",
          "    adharNumber:   '895698569586',",
          "    bankName:      'SBI'",
          "};",
          "",
          "Object.keys(defaults).forEach(function(key) {",
          "    if (!pm.environment.get(key)) {",
          "        pm.environment.set(key, defaults[key]);",
          "        console.warn('[pre-request] ' + key + ' not set — using default:', defaults[key]);",
          "    }",
          "});",
          "",
          "// ----------------------------------------------------------",
          "// 3. Log the current request being executed",
          "// ----------------------------------------------------------",
          "console.log('[pre-request] Running:', pm.info.requestName, '|', pm.request.method, pm.request.url.toString());",
          "",
          "// ----------------------------------------------------------",
          "// 4. Set Content-Type header if request has a body and",
          "//    Content-Type is not already set",
          "// ----------------------------------------------------------",
          "if (pm.request.body && pm.request.body.raw) {",
          "    var hasContentType = pm.request.headers.has('Content-Type');",
          "    if (!hasContentType) {",
          "        pm.request.headers.add({",
          "            key: 'Content-Type',",
          "            value: 'application/json'",
          "        });",
          "        console.log('[pre-request] Content-Type header added automatically');",
          "    }",
          "}",
          "",
          "// ----------------------------------------------------------",
          "// 5. Timestamp — useful for debugging run timing",
          "// ----------------------------------------------------------",
          "pm.environment.set('runTimestamp', new Date().toISOString());",
          "console.log('[pre-request] Run timestamp:', pm.environment.get('runTimestamp'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ============================================================",
          "// real-bank-api — Collection-level Post-response Test Script",
          "// Runs after EVERY request in this collection",
          "// ============================================================",
          "",
          "// ----------------------------------------------------------",
          "// 1. Response time check — all requests must respond < 5s",
          "// ----------------------------------------------------------",
          "pm.test('[Common] Response time is under 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// ----------------------------------------------------------",
          "// 2. No 4xx client errors (except 404 which may be valid",
          "//    for deleted/non-existent accounts)",
          "// ----------------------------------------------------------",
          "pm.test('[Common] No unexpected client errors (4xx)', function () {",
          "    var code = pm.response.code;",
          "    // Allow 404 as it can be a valid response for missing accounts",
          "    pm.expect(code).to.not.be.oneOf([400, 401, 403, 405, 409, 422, 429]);",
          "});",
          "",
          "// ----------------------------------------------------------",
          "// 3. No 5xx server errors",
          "// ----------------------------------------------------------",
          "pm.test('[Common] No server errors (5xx)', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "",
          "// ----------------------------------------------------------",
          "// 4. Content-Type is application/json for non-empty responses",
          "// ----------------------------------------------------------",
          "if (pm.response.code !== 204 && pm.response.text().length > 0) {",
          "    pm.test('[Common] Response Content-Type is application/json', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    });",
          "}",
          "",
          "// ----------------------------------------------------------",
          "// 5. Response body is valid JSON for non-empty responses",
          "// ----------------------------------------------------------",
          "if (pm.response.code !== 204 && pm.response.text().length > 0) {",
          "    pm.test('[Common] Response body is valid JSON', function () {",
          "        pm.expect(function () {",
          "            pm.response.json();",
          "        }).to.not.throw();",
          "    });",
          "}",
          "",
          "// ----------------------------------------------------------",
          "// 6. Log response summary to console for every request",
          "// ----------------------------------------------------------",
          "console.log(",
          "    '[post-response]', pm.info.requestName,",
          "    '| Status:', pm.response.code,",
          "    '| Time:', pm.response.responseTime + 'ms'",
          ");",
          "",
          "// ----------------------------------------------------------",
          "// 7. Alert on 5xx — log full response body for debugging",
          "// ----------------------------------------------------------",
          "if (pm.response.code >= 500) {",
          "    console.error('[post-response] SERVER ERROR on', pm.info.requestName);",
          "    console.error('[post-response] Response body:', pm.response.text());",
          "}",
          "",
          "// ----------------------------------------------------------",
          "// 8. Alert on unexpected 4xx — log details for debugging",
          "// ----------------------------------------------------------",
          "if (pm.response.code >= 400 && pm.response.code < 500 && pm.response.code !== 404 && pm.response.code !== 204) {",
          "    console.warn('[post-response] CLIENT ERROR on', pm.info.requestName, '| Code:', pm.response.code);",
          "    console.warn('[post-response] Response body:', pm.response.text());",
          "}"
        ]
      }
    }
