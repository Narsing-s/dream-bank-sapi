    {
      "name": "deposit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// deposit — POST /api/accounts/{{accountNumber}}/deposit",
              "pm.test('Status code is 200', function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "",
              "pm.test('Response has JSON body', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Response contains accountNumber', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('accountNumber');",
              "});",
              "",
              "pm.test('Response contains balance', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('balance');",
              "});",
              "",
              "pm.test('Balance is a number after deposit', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.balance).to.be.a('number');",
              "});",
              "",
              "pm.test('Balance is greater than zero after deposit', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.balance).to.be.above(0);",
              "});",
              "",
              "pm.test('Response contains transactionId', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('transactionId');",
              "});",
              "",
              "pm.test('Balance increased after deposit compared to post-withdrawal balance', function () {",
              "    var jsonData = pm.response.json();",
              "    var prevBalance = parseFloat(pm.environment.get('balanceAfterWithdraw'));",
              "    if (!isNaN(prevBalance)) {",
              "        pm.expect(jsonData.balance).to.be.above(prevBalance);",
              "    } else {",
              "        console.warn('[deposit] balanceAfterWithdraw not set — skipping balance comparison');",
              "    }",
              "});",
              "",
              "// Save updated balance",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.balance !== undefined) {",
              "        pm.environment.set('balanceAfterDeposit', jsonData.balance);",
              "        console.log('[deposit] Balance after deposit:', jsonData.balance);",
              "    }",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
